# Docker Compose defaults. Use the SQLite fast path by leaving DATABASE_URL unset locally.
DATABASE_URL=postgresql+psycopg://browserbridge:browserbridge-local@postgres:5432/browserbridge
REDIS_URL=redis://redis:6379/0
BROWSER_URL=http://app:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://app:8000
PUBLIC_PORT=8000
DEMO_IDENTITY=true
DEMO_PASSWORD=demo-local-only
SECURE_COOKIE=false
TEST_MODE=false
EVIDENCE_RETENTION_SECONDS=604800
# Optional OpenAI-compatible multimodal provider.
MODEL_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
# Set to the full OTLP HTTP traces endpoint if a collector is available.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
